# Copy this to .env.local and fill in real values. .env.local is
# git-ignored — never commit real API keys. On Vercel, set the same names
# under Project → Settings → Environment Variables. docs/setup.md walks
# through each service.
#
# Everything is optional: with none of it set the site works as before
# (booking forms show the phone/WhatsApp fallback, the live chat says
# "coming soon"). Each block switches on its own part.

# Production URL, used for canonical links, sitemap.xml, robots.txt, and
# resolving Open Graph/Twitter image URLs (src/lib/seo.ts). Defaults to
# https://mpenortheast.co.uk if unset — update this once the real domain
# is pointed at the Vercel deployment, or set it here to override before
# then (e.g. a Vercel preview/staging URL). Links in texts and emails
# (e.g. the missed-call text's chat link) use it too.
NEXT_PUBLIC_SITE_URL=

# --- Supabase: live chat, the team inbox and jobs -------------------------
# Project Settings → API. The URL and anon key switch on the live chat
# (/messages) and team login; the service-role key lets the server save
# booking forms as jobs and runs the inbox. Never expose the service key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend: emails -------------------------------------------------------
# Booking forms are emailed to MPE (src/app/api/contact/route.ts), and
# customers get an email when an engineer replies in the chat.
# - RESEND_API_KEY: an API key from the Resend dashboard ("re_…").
# - CONTACT_TO_EMAIL: the inbox that receives booking forms. Defaults to
#   the business email in src/lib/content.ts.
# - CONTACT_FROM_EMAIL: the sender, e.g. "MPE <hello@mpenortheast.co.uk>".
#   Must be on a domain verified in Resend; until one is, Resend's
#   onboarding@resend.dev only sends to the account owner's own address.
# - CHAT_REPLY_DOMAIN + RESEND_WEBHOOK_SECRET (optional): let customers
#   answer a reply email straight back into the chat. CHAT_REPLY_DOMAIN is
#   a subdomain with Resend inbound MX records (e.g. reply.mpenortheast.co.uk);
#   the secret is the signing secret of a webhook pointed at
#   /api/webhooks/resend for the email.received event.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CHAT_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=

# --- Twilio: texts and missed calls ---------------------------------------
# The business number (E.164, e.g. +447…). Calls to it are filed in the
# inbox and texted back with the live chat link; texts to it land in the
# inbox and engineers can text back. Auth token is always needed (it
# verifies Twilio's webhooks); an API key pair is optional and preferred
# for sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# --- The MPE app (next stage) ---------------------------------------------
# Store links shown after a customer leaves their details in the chat.
# Until set, they're told they'll get an email instead.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# --- Automatic reminders and follow-ups -------------------------------------
# Vercel Cron calls /api/cron/follow-ups every five minutes (vercel.json)
# and signs the call with this: day-before and hour-before reminders,
# "sorry we missed you", booking-form follow-ups, service due, and the
# team's nudges (src/lib/follow-up-sweep.ts). Any long random string;
# Vercel sends it automatically once it's set.
CRON_SECRET=
