# Copy this to .env.local and fill in real values. .env.local is
# git-ignored — never commit real API keys.

# Address lookup (src/app/api/address-lookup/route.ts) — powers the postcode
# search on the create-account page. Sign up at https://ideal-postcodes.co.uk
# for a real key. Without this set, address lookup falls back to Ideal
# Postcodes' public "ak_test" key in development only (capped at 5
# lookups/day, not usable in production) and is disabled entirely in
# production.
IDEAL_POSTCODES_API_KEY=

# Production URL, used for canonical links, sitemap.xml, robots.txt, and
# resolving Open Graph/Twitter image URLs (src/lib/seo.ts). Defaults to
# https://mpenortheast.co.uk if unset — update this once the real domain
# is pointed at the Vercel deployment, or set it here to override before
# then (e.g. a Vercel preview/staging URL).
NEXT_PUBLIC_SITE_URL=
