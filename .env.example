# Copy this to .env.local and fill in real values. .env.local is
# git-ignored — never commit real API keys.

# Production URL, used for canonical links, sitemap.xml, robots.txt, and
# resolving Open Graph/Twitter image URLs (src/lib/seo.ts). Defaults to
# https://mpenortheast.co.uk if unset — update this once the real domain
# is pointed at the Vercel deployment, or set it here to override before
# then (e.g. a Vercel preview/staging URL).
NEXT_PUBLIC_SITE_URL=

# Contact form delivery (src/app/api/contact/route.ts). Enquiries from the
# booking/quote form are emailed via Resend (https://resend.com).
# - RESEND_API_KEY: an API key from the Resend dashboard ("re_…").
# - CONTACT_TO_EMAIL: the inbox that receives enquiries. Defaults to the
#   business email in src/lib/content.ts.
# - CONTACT_FROM_EMAIL: the sender. Must be on a domain verified in Resend;
#   until one is, Resend's onboarding@resend.dev works for sending to the
#   account owner's own address only.
# Until RESEND_API_KEY is set the form shows the phone/WhatsApp fallback
# instead of pretending the message went through.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
